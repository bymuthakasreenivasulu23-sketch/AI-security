# ==============================================================================
# TRUSTLENS AI — MONOREPO ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT CONFIGURATION (For Vercel Deployment)
# ------------------------------------------------------------------------------
# URL of the deployed Render backend API (do not include trailing slash)
# Leave empty for local development to use the Vite proxy (/api)
VITE_API_URL=https://your-backend-app.onrender.com

# ------------------------------------------------------------------------------
# 2. CORE BACKEND SERVER CONFIGURATION (For Render Deployment)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 3. AI REASONING CONFIGURATION (OPTIONAL)
# If omitted or left empty, TrustLens automatically uses its local deterministic
# rule-based heuristic engine with zero degradation in core detection flow.
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Configurable Gemini model identifier (recommended: gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (OPTIONAL)
# If omitted or unreachable, TrustLens automatically uses its resilient
# in-memory store.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@host:5432/trustlens_ai

# ------------------------------------------------------------------------------
# 5. SECURITY, CORS & RATE LIMITING (OPTIONAL)
# ------------------------------------------------------------------------------
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
# Comma-separated list of allowed origins (e.g. your Vercel URL and local dev)
CORS_ORIGIN=https://your-frontend-app.vercel.app,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=20
