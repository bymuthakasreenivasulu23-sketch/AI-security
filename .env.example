# ==============================================================================
# TRUSTLENS AI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (Defaulted if omitted)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. AI REASONING CONFIGURATION (OPTIONAL)
# If omitted or left empty, TrustLens automatically uses its local deterministic
# rule-based heuristic engine with zero degradation in core detection flow.
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Configurable Gemini model identifier (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (OPTIONAL)
# If omitted or unreachable, TrustLens automatically uses its resilient
# in-memory store. Scans and settings will persist during the server session.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustlens_ai

# ------------------------------------------------------------------------------
# 4. SECURITY, CORS & RATE LIMITING (OPTIONAL)
# ------------------------------------------------------------------------------
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
CORS_ORIGIN=http://localhost:5173,http://localhost:5000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=20
