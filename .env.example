# ==============================================================================
# TRUSTLENS AI — ENVIRONMENT CONFIGURATION REFERENCE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT (SET IN VERCEL)
# ------------------------------------------------------------------------------
# URL of the deployed Render backend API (do not include trailing slash)
# Leave empty for local development to use the Vite proxy (/api)
VITE_API_URL=https://your-backend-app.onrender.com

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER (SET IN RENDER)
# ------------------------------------------------------------------------------
# PORT is assigned dynamically by Render (defaults to 5000 locally)
PORT=5000
NODE_ENV=production
# Comma-separated list of allowed origins (your Vercel URL and local dev)
CORS_ORIGIN=https://your-frontend-app.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. AI REASONING (OPTIONAL — SERVER ONLY, NEVER PUT IN VERCEL)
# If omitted, TrustLens uses its deterministic rule-based heuristic engine.
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (OPTIONAL — SERVER ONLY, NEVER PUT IN VERCEL)
# If omitted or unreachable, TrustLens uses its resilient in-memory store.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@host:5432/trustlens_ai

# ------------------------------------------------------------------------------
# 5. RATE LIMITING TUNING (OPTIONAL — SERVER ONLY)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=20
