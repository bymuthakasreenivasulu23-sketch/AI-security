# Render Backend Environment Variables
# ------------------------------------------------------------------------------
# CORE / PRODUCTION CONFIGURATION (REQUIRED ON RENDER)
# ------------------------------------------------------------------------------
# PORT is assigned dynamically by Render at runtime. You do not need to set it manually.
PORT=5000
NODE_ENV=production
# URL of your deployed Vercel frontend (for CORS access)
CORS_ORIGIN=https://your-frontend-app.vercel.app

# ------------------------------------------------------------------------------
# OPTIONAL: AI REASONING (Gemini)
# If empty, TrustLens uses its local deterministic heuristic engine.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# ------------------------------------------------------------------------------
# OPTIONAL: DATABASE CONFIGURATION (PostgreSQL)
# If empty or unreachable, TrustLens uses its resilient in-memory store.
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# OPTIONAL: RATE LIMITING TUNING
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=20
